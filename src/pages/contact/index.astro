---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/footer/Footer.astro';

const pageTitle = 'Contact NEEL ENTERPRISES | Forklift Service India';
const pageDescription = 'Get in touch with NEEL ENTERPRISES for forklift repair, maintenance, spare parts, and rental services. WhatsApp, email, or visit our offices in Kinnigoli and Bengaluru.';
const canonicalURL = 'https://neelenterprises.com/contact/';
---

<BaseLayout lang="en">
  <Header />

  <main class="min-h-screen bg-white dark:bg-gray-950">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-orange-50 to-blue-50 dark:from-gray-900 dark:to-gray-800"></div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6">
            Get In <span class="text-orange-600">Touch</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8">
            Ready to Keep Your Operations Moving?
          </p>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Contact us for forklift repair, maintenance, spare parts, rental services, or technical support. We respond promptly to all enquiries.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Methods Section -->
    <section class="py-20 bg-white dark:bg-gray-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
          <!-- WhatsApp -->
          <a 
            href="https://wa.me/918105142089?text=Hello%20NEEL%20ENTERPRISES%2C%20I%20would%20like%20to%20enquire%20about%20your%20forklift%20services."
            target="_blank"
            rel="noopener noreferrer"
            class="group p-8 bg-green-50 dark:bg-green-900/20 rounded-2xl hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-green-500"
          >
            <div class="w-16 h-16 bg-green-500 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">WhatsApp Us</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">Quick response for urgent enquiries and breakdowns</p>
            <p class="text-green-600 dark:text-green-400 font-semibold">+91 81051 42089</p>
          </a>

          <!-- Email -->
          <a 
            href="mailto:neelenterprises.741@gmail.com"
            class="group p-8 bg-blue-50 dark:bg-blue-900/20 rounded-2xl hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-blue-500"
          >
            <div class="w-16 h-16 bg-blue-500 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Email Us</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">Detailed enquiries with attachments</p>
            <p class="text-blue-600 dark:text-blue-400 font-semibold break-all">neelenterprises.741@gmail.com</p>
          </a>

          <!-- Request Service -->
          <a 
            href="/request-service/"
            class="group p-8 bg-orange-50 dark:bg-orange-900/20 rounded-2xl hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-orange-500"
          >
            <div class="w-16 h-16 bg-orange-500 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Request Service</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">Fill out our detailed service request form</p>
            <p class="text-orange-600 dark:text-orange-400 font-semibold">Online Form →</p>
          </a>
        </div>

        <!-- Office Locations -->
        <div class="mb-20">
          <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 dark:text-white mb-12">
            Our Offices
          </h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Kinnigoli Office (Registered) -->
            <div class="bg-gray-50 dark:bg-gray-900 rounded-2xl overflow-hidden shadow-lg">
              <div class="p-8">
                <div class="flex items-start mb-6">
                  <div class="w-12 h-12 bg-orange-500 rounded-xl flex items-center justify-center mr-4 flex-shrink-0">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-8a2 2 0 012-2h14a2 2 0 012 2v8M5 10l7-7 7 7M5 10v11h14V10"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Registered Office</h3>
                    <p class="text-orange-600 dark:text-orange-400 font-semibold">Kinnigoli</p>
                  </div>
                </div>
                
                <address class="not-italic text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
                  No.11-87/3 & 11-87/4, SDANANDA BUILDING,<br/>
                  KINNIGOLI MAIN ROAD, OPPOSITE DURGAPRASAD RECIDENCY,<br/>
                  MENNABETU, KINNIGOLI – 574150
                </address>
                
                <a 
                  href="https://www.google.com/maps/search/?api=1&query=Kinnigoli+Main+Road+Mennabetu+Kinnigoli+574150"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 font-semibold transition-colors"
                >
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  View on Google Maps
                </a>
              </div>
              
              <div class="h-64 bg-gray-200 dark:bg-gray-800">
                <iframe 
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3855.547190826909!2d74.9089!3d12.7893!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba35c7b0a0a0a0b%3A0x0!2sKinnigoli%2C%20Karnataka%20574150!5e0!3m2!1sen!2sin!4v1234567890"
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Kinnigoli Office Location"
                ></iframe>
              </div>
            </div>

            <!-- Bengaluru Office (Branch) -->
            <div class="bg-gray-50 dark:bg-gray-900 rounded-2xl overflow-hidden shadow-lg">
              <div class="p-8">
                <div class="flex items-start mb-6">
                  <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center mr-4 flex-shrink-0">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Branch Office</h3>
                    <p class="text-blue-600 dark:text-blue-400 font-semibold">Bengaluru (Chikkabanavara)</p>
                  </div>
                </div>
                
                <address class="not-italic text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
                  Sy No-14/5, Hanuman Layout,<br/>
                  Hesaraghatta Main Road, Near Chikkabanavara Railway Station,<br/>
                  Chikkabanavara, Bangalore – 560090
                </address>
                
                <a 
                  href="https://www.google.com/maps/search/?api=1&query=Chikkabanavara+Railway+Station+Bangalore+560090"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold transition-colors"
                >
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  View on Google Maps
                </a>
              </div>
              
              <div class="h-64 bg-gray-200 dark:bg-gray-800">
                <iframe 
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3884.52823456789!2d77.5193!3d13.0358!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae1768c8c8c8c9%3A0x0!2sChikkabanavara%2C%20Bangalore%2C%20Karnataka%20560090!5e0!3m2!1sen!2sin!4v1234567890"
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Bengaluru Office Location"
                ></iframe>
              </div>
            </div>
          </div>
        </div>

        <!-- Service Areas -->
        <div class="bg-gradient-to-br from-orange-600 to-orange-700 rounded-2xl p-8 md:p-12 text-white">
          <div class="text-center mb-8">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Service Coverage</h2>
            <p class="text-xl text-orange-100 max-w-3xl mx-auto">
              While our physical offices are in Kinnigoli and Bengaluru, we accept enquiries from across India and can arrange service in various locations.
            </p>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div>
              <div class="text-3xl font-bold mb-2">Karnataka</div>
              <div class="text-orange-200">Primary Service Area</div>
            </div>
            <div>
              <div class="text-3xl font-bold mb-2">South India</div>
              <div class="text-orange-200">Extended Coverage</div>
            </div>
            <div>
              <div class="text-3xl font-bold mb-2">Pan-India</div>
              <div class="text-orange-200">Enquiry Support</div>
            </div>
            <div>
              <div class="text-3xl font-bold mb-2">Remote</div>
              <div class="text-orange-200">Technical Consultation</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Enquiry CTA -->
    <section class="py-20 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
          Have a Specific Requirement?
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
          Whether you need emergency breakdown support, scheduled maintenance, spare parts, or equipment rental - we're here to help keep your operations moving.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="https://wa.me/918105142089?text=Hello%20NEEL%20ENTERPRISES%2C%20I%20have%20a%20forklift%20breakdown%20and%20need%20urgent%20assistance."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-700 transition-colors duration-300 shadow-lg"
          >
            <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Emergency Breakdown Support
          </a>
          <a 
            href="/request-service/"
            class="inline-flex items-center justify-center px-8 py-4 bg-orange-600 text-white font-semibold rounded-xl hover:bg-orange-700 transition-colors duration-300 shadow-lg"
          >
            Submit Service Request
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  
  <script>
    document.title = pageTitle;
    
    const metaDescription = document.querySelector('meta[name="description"]');
    if (metaDescription) {
      metaDescription.setAttribute('content', pageDescription);
    } else {
      const newMeta = document.createElement('meta');
      newMeta.name = 'description';
      newMeta.content = pageDescription;
      document.head.appendChild(newMeta);
    }
    
    const linkCanonical = document.querySelector('link[rel="canonical"]');
    if (linkCanonical) {
      linkCanonical.setAttribute('href', canonicalURL);
    } else {
      const newLink = document.createElement('link');
      newLink.rel = 'canonical';
      newLink.href = canonicalURL;
      document.head.appendChild(newLink);
    }
  </script>
</BaseLayout>
