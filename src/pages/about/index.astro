---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/footer/Footer.astro';

const pageTitle = 'About NEEL ENTERPRISES | Material Handling Engineering';
const pageDescription = '18+ years of professional experience in material handling equipment. Expert forklift repair, maintenance, spare parts, and rental services across India.';
const canonicalURL = 'https://neelenterprises.com/about/';
---

<BaseLayout lang="en">
  <Header />

  <main class="min-h-screen bg-white dark:bg-gray-950">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800"></div>
      <div class="absolute inset-0 opacity-5 dark:opacity-10">
        <div class="absolute top-20 left-10 w-72 h-72 bg-orange-500 rounded-full filter blur-3xl"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-blue-600 rounded-full filter blur-3xl"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6">
            About <span class="text-orange-600">NEEL ENTERPRISES</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
            Keeping Your Operations Moving Since 2006
          </p>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Professional material handling engineering solutions with 18+ years of expertise in forklift repair, maintenance, and spare parts across India.
          </p>
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="py-20 bg-white dark:bg-gray-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
              Our Story
            </h2>
            <div class="space-y-4 text-gray-600 dark:text-gray-300 leading-relaxed">
              <p>
                NEEL ENTERPRISES has been serving the Indian material handling industry for over 18 years, providing comprehensive solutions for electric and diesel forklifts, warehouse equipment, and industrial machinery.
              </p>
              <p>
                Founded on the principles of technical excellence, quick response, and cost-effective solutions, we have built a reputation for reliability among businesses across automotive, engineering, pharmaceutical, and warehousing sectors.
              </p>
              <p>
                Our qualified technical staff brings deep expertise in engine and transmission overhauling, battery service and reconditioning, traction controller repair, and comprehensive maintenance programs that keep your operations running smoothly.
              </p>
              <p>
                With offices in Kinnigoli (Mangaluru region) and Bengaluru, we serve customers across India with prompt service and genuine spare parts support.
              </p>
            </div>
          </div>
          
          <div class="relative">
            <div class="aspect-video bg-gradient-to-br from-orange-100 to-orange-200 dark:from-orange-900/30 dark:to-orange-800/30 rounded-2xl overflow-hidden shadow-2xl">
              <img 
                src="/images/company/neel-enterprises-team.jpg" 
                alt="NEEL ENTERPRISES technical team at work"
                class="w-full h-full object-cover"
                loading="lazy"
                onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 800 600%22%3E%3Crect fill=%22%23f97316%22 width=%22800%22 height=%22600%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22white%22 font-size=%2232%22 font-family=%22Arial%22%3ENeel Enterprises Team%3C/text%3E%3C/svg%3E'"
              />
            </div>
            <div class="absolute -bottom-6 -left-6 w-48 h-48 bg-orange-600 rounded-2xl -z-10"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capabilities Section -->
    <section class="py-20 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Technical Capabilities
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Comprehensive expertise across all major forklift systems and components
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Capability Card 1 -->
          <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-14 h-14 bg-orange-100 dark:bg-orange-900/30 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Engine & Transmission</h3>
            <p class="text-gray-600 dark:text-gray-400">Complete overhauling services for diesel engines and transmission systems with precision engineering.</p>
          </div>

          <!-- Capability Card 2 -->
          <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Battery Systems</h3>
            <p class="text-gray-600 dark:text-gray-400">Sales, inspection, service, and reconditioning of traction batteries for electric forklifts.</p>
          </div>

          <!-- Capability Card 3 -->
          <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-14 h-14 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Controller Repair</h3>
            <p class="text-gray-600 dark:text-gray-400">Expert diagnosis and repair of traction controllers and electrical control systems.</p>
          </div>

          <!-- Capability Card 4 -->
          <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-14 h-14 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Hydraulic Systems</h3>
            <p class="text-gray-600 dark:text-gray-400">Complete hydraulic system repair including pumps, cylinders, valves, and hoses.</p>
          </div>

          <!-- Capability Card 5 -->
          <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-14 h-14 bg-red-100 dark:bg-red-900/30 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Preventive Maintenance</h3>
            <p class="text-gray-600 dark:text-gray-400">Scheduled inspections and maintenance contracts to prevent breakdowns and extend equipment life.</p>
          </div>

          <!-- Capability Card 6 -->
          <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="w-14 h-14 bg-yellow-100 dark:bg-yellow-900/30 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Spare Parts</h3>
            <p class="text-gray-600 dark:text-gray-400">Genuine and compatible spare parts including tyres, wheels, hydraulic and electrical components.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Brands Experience Section -->
    <section class="py-20 bg-white dark:bg-gray-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Technical Experience Across Major Brands
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            We have extensive service experience with leading forklift manufacturers
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
          {['Jungheinrich', 'Toyota', 'BT', 'Jost', 'Maini', 'Macneill', 'Baka', 'Godrej', 'Voltas'].map((brand) => (
            <div class="flex items-center justify-center p-6 bg-gray-50 dark:bg-gray-900 rounded-xl hover:shadow-md transition-shadow duration-300">
              <img 
                src={`/images/brands/${brand.toLowerCase()}.png`}
                alt={`${brand} forklift brand`}
                class="h-12 object-contain grayscale hover:grayscale-0 transition-all duration-300"
                loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='block'"
              />
              <span class="hidden text-gray-700 dark:text-gray-300 font-semibold">{brand}</span>
            </div>
          ))}
        </div>

        <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-8 max-w-3xl mx-auto">
          Note: We provide independent service and support for these brands. We are not an authorized dealer or service center unless explicitly stated.
        </p>
      </div>
    </section>

    <!-- Values Section -->
    <section class="py-20 bg-gradient-to-br from-orange-600 to-orange-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Why Choose NEEL ENTERPRISES?
          </h2>
          <p class="text-lg text-orange-100 max-w-3xl mx-auto">
            Built on trust, expertise, and commitment to customer success
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="text-5xl font-bold text-white mb-2">18+</div>
            <div class="text-orange-100 text-lg">Years Experience</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-white mb-2">100%</div>
            <div class="text-orange-100 text-lg">Commitment</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-white mb-2">Multi-</div>
            <div class="text-orange-100 text-lg">Brand Expertise</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-white mb-2">Pan-</div>
            <div class="text-orange-100 text-lg">India Service</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
          Ready to Keep Your Operations Moving?
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
          Get in touch with our expert team for forklift repair, maintenance, spare parts, or rental services.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="https://wa.me/918105142089?text=Hello%20NEEL%20ENTERPRISES%2C%20I%20would%20like%20to%20enquire%20about%20your%20forklift%20services."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-green-600 text-white font-semibold rounded-xl hover:bg-green-700 transition-colors duration-300 shadow-lg"
          >
            <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp Us
          </a>
          <a 
            href="mailto:neelenterprises.741@gmail.com"
            class="inline-flex items-center justify-center px-8 py-4 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors duration-300 shadow-lg"
          >
            <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Email Us
          </a>
          <a 
            href="/request-service/"
            class="inline-flex items-center justify-center px-8 py-4 bg-orange-600 text-white font-semibold rounded-xl hover:bg-orange-700 transition-colors duration-300 shadow-lg"
          >
            Request Service
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  
  <script>
    // Set page-specific meta tags
    document.title = pageTitle;
    
    const metaDescription = document.querySelector('meta[name="description"]');
    if (metaDescription) {
      metaDescription.setAttribute('content', pageDescription);
    } else {
      const newMeta = document.createElement('meta');
      newMeta.name = 'description';
      newMeta.content = pageDescription;
      document.head.appendChild(newMeta);
    }
    
    const linkCanonical = document.querySelector('link[rel="canonical"]');
    if (linkCanonical) {
      linkCanonical.setAttribute('href', canonicalURL);
    } else {
      const newLink = document.createElement('link');
      newLink.rel = 'canonical';
      newLink.href = canonicalURL;
      document.head.appendChild(newLink);
    }
  </script>
</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>
