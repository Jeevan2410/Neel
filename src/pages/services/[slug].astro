---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/footer/Footer.astro';
import { servicePages } from '../../data/services';

export async function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// Generate structured data
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.title,
  "description": service.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "NEEL ENTERPRISES",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "No.11-87/3 & 11-87/4, SDANANDA BUILDING, KINNIGOLI MAIN ROAD, OPPOSITE DURGAPRASAD RECIDENCY, MENNABETU, KINNIGOLI – 574150",
      "addressLocality": "Kinnigoli",
      "addressRegion": "Karnataka",
      "postalCode": "574150",
      "addressCountry": "IN"
    },
    "telephone": "+91 81051 42089",
    "email": "neelenterprises.741@gmail.com"
  },
  "areaServed": {
    "@type": "Country",
    "name": "India"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Forklift Services",
    "itemListElement": service.relatedServices.map(s => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": s.name
      }
    }))
  }
};
---

<BaseLayout
  title={`${service.title} | NEEL ENTERPRISES`}
  description={service.description}
  canonical={`/services/${service.slug}/`}
>
  <Header />
  
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 py-20 md:py-28 overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 32px 32px;"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center">
        <!-- Service Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          {service.category}
        </div>
        
        <!-- Title -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          {service.title}
        </h1>
        
        <!-- Description -->
        <p class="text-xl text-slate-300 max-w-3xl mx-auto mb-8">
          {service.description}
        </p>
        
        <!-- Power Type Badge -->
        {service.powerType && (
          <div class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-slate-800/50 border border-slate-700 text-slate-300">
            <span class="text-sm font-medium">Available for:</span>
            <span class={`px-3 py-1 rounded-full text-xs font-semibold ${
              service.powerType === 'electric' 
                ? 'bg-green-500/20 text-green-400 border border-green-500/30' 
                : service.powerType === 'diesel'
                ? 'bg-orange-500/20 text-orange-400 border border-orange-500/30'
                : 'bg-blue-500/20 text-blue-400 border border-blue-500/30'
            }`}>
              {service.powerType === 'electric' ? '⚡ Electric Forklifts' : service.powerType === 'diesel' ? '🔥 Diesel Forklifts' : '⚙️ Both Types'}
            </span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- What This Service Covers -->
  <section class="py-16 md:py-20 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6">
            What This Service Covers
          </h2>
          <ul class="space-y-3">
            {service.whatCovers.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-700 dark:text-slate-300">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="bg-slate-50 dark:bg-slate-800 rounded-2xl p-8 border border-slate-200 dark:border-slate-700">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-4">
            Common Signs You Need This Service
          </h3>
          <ul class="space-y-3">
            {service.commonSigns.map((sign) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span class="text-slate-700 dark:text-slate-300">{sign}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Capability -->
  <section class="py-16 md:py-20 bg-slate-50 dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">
          NEEL's Expertise
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-3xl mx-auto">
          With 18+ years of experience in material handling equipment, our qualified technical staff delivers precise, cost-effective solutions.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {service.capabilities.map((capability, index) => (
          <div class="bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-500 transition-colors">
            <div class="w-12 h-12 rounded-lg bg-blue-500/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">
              {capability.title}
            </h3>
            <p class="text-slate-600 dark:text-slate-400">
              {capability.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Process -->
  {service.process && (
    <section class="py-16 md:py-20 bg-white dark:bg-slate-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">
            Our Service Process
          </h2>
          <p class="text-lg text-slate-600 dark:text-slate-400">
            A systematic approach to ensure quality and reliability
          </p>
        </div>
        
        <div class="grid md:grid-cols-4 gap-6">
          {service.process.map((step, index) => (
            <div class="relative">
              <div class="text-center">
                <div class="w-12 h-12 rounded-full bg-blue-500 text-white flex items-center justify-center text-lg font-bold mx-auto mb-4">
                  {index + 1}
                </div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">
                  {step.title}
                </h3>
                <p class="text-slate-600 dark:text-slate-400 text-sm">
                  {step.description}
                </p>
              </div>
              {index < service.process.length - 1 && (
                <div class="hidden md:block absolute top-6 left-1/2 w-full h-0.5 bg-gradient-to-r from-blue-500 to-transparent"></div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Services -->
  <section class="py-16 md:py-20 bg-slate-50 dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8 text-center">
        Related Services
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.relatedServices.map((related) => (
          <a 
            href={`/services/${related.slug}`}
            class="group block bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-500 transition-all hover:shadow-lg"
          >
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-lg font-semibold text-slate-900 dark:text-white group-hover:text-blue-500 transition-colors">
                {related.name}
              </h3>
              <svg class="w-5 h-5 text-slate-400 group-hover:text-blue-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <p class="text-slate-600 dark:text-slate-400 text-sm">
              {related.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-blue-600 to-blue-700 dark:from-blue-700 dark:to-blue-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        Need {service.title.toLowerCase()}?
      </h2>
      <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
        Get in touch with our experts for professional service across India
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={`https://wa.me/918105142089?text=${encodeURIComponent(`Hello NEEL ENTERPRISES, I need help with ${service.title}.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-green-500 hover:bg-green-600 text-white rounded-lg font-semibold transition-colors shadow-lg"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp Us
        </a>
        <a
          href={`mailto:neelenterprises.741@gmail.com?subject=${encodeURIComponent(`Enquiry: ${service.title}`)}&body=${encodeURIComponent(`Dear NEEL ENTERPRISES,\n\nI am interested in ${service.title}.\n\nPlease contact me to discuss further.\n\nThank you.`)}`}
          class="inline-flex items-center gap-2 px-8 py-4 bg-white text-blue-600 rounded-lg font-semibold hover:bg-blue-50 transition-colors shadow-lg"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Email Us
        </a>
        <a
          href="/request-service"
          class="inline-flex items-center gap-2 px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white rounded-lg font-semibold transition-colors shadow-lg"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Request Service
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
