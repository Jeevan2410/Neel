        <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-300 mb-12 leading-relaxed">
          NEEL ENTERPRISES has been providing professional material handling solutions with qualified technical staff, 
          quick service delivery, and cost-effective solutions for electric and diesel forklifts across India.
        </p>
        
        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
          <div class="text-center p-6 bg-white dark:bg-neutral-800 rounded-lg shadow-sm">
            <div class="text-4xl md:text-5xl font-bold text-primary-600 dark:text-primary-400 mb-2">18+</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400">Years Experience</div>
