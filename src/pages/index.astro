            </svg>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-50 mb-2">Spare Parts</h3>
          <p class="text-neutral-600 dark:text-neutral-300 mb-4">Genuine spare parts including tyres, wheels, hydraulic components, and electrical parts for all major brands.</p>
          <a href="/services/spare-parts" class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors">
            Learn more
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </article>
        
        <article class="group p-8 bg-neutral-50 dark:bg-neutral-700 rounded-lg border border-neutral-200 dark:border-neutral-600 hover:border-primary-500 dark:hover:border-primary-400 transition-all duration-300 hover:shadow-lg">
          <div class="w-12 h-12 bg-accent-100 dark:bg-accent-900 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent-500 transition-colors">
            <svg class="w-6 h-6 text-accent-600 dark:text-accent-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
