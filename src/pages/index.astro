          <div class="text-center p-6 bg-white dark:bg-neutral-800 rounded-lg shadow-sm">
            <div class="text-4xl md:text-5xl font-bold text-primary-600 dark:text-primary-400 mb-2">Multi-Brand</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400">Technical Expertise</div>
          </div>
          <div class="text-center p-6 bg-white dark:bg-neutral-800 rounded-lg shadow-sm">
            <div class="text-4xl md:text-5xl font-bold text-primary-600 dark:text-primary-400 mb-2">Pan-India</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400">Service Coverage</div>
          </div>
          <div class="text-center p-6 bg-white dark:bg-neutral-800 rounded-lg shadow-sm">
