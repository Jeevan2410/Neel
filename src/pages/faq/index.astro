---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/footer/Footer.astro';

const pageTitle = 'FAQ | NEEL ENTERPRISES Forklift Services';
const pageDescription = 'Frequently asked questions about forklift repair, maintenance, spare parts, rental services, and technical support from NEEL ENTERPRISES.';
const canonicalURL = 'https://neelenterprises.com/faq/';

const faqs = [
  {
    question: "What types of forklifts do you service?",
    answer: "We service both electric and diesel forklifts across all major brands including Jungheinrich, Toyota, BT, Jost, Maini, Macneill, Baka, Godrej, and Voltas. Our expertise covers material handling equipment of various capacities and configurations."
  },
  {
    question: "Do you provide on-site service?",
    answer: "Yes, we offer on-site service for breakdown repairs, preventive maintenance, and inspections. Our technical team can visit your facility to diagnose and resolve issues, minimizing downtime and disruption to your operations."
  },
  {
    question: "What is preventive maintenance and why is it important?",
    answer: "Preventive maintenance involves scheduled inspections and servicing to identify wear and potential issues before they cause breakdowns. Regular maintenance extends equipment life, improves safety, reduces unexpected downtime, and is more cost-effective than emergency repairs."
  },
  {
    question: "Do you repair forklift batteries?",
    answer: "Yes, we provide comprehensive battery services including inspection, service, reconditioning, and replacement of traction batteries for electric forklifts. We also service battery chargers and provide related electrical diagnostics."
  },
  {
    question: "Can you help with spare parts procurement?",
    answer: "Absolutely. We supply genuine and compatible spare parts including tyres, wheels, hydraulic components, electrical parts, and other critical components. Contact us with your part requirements, forklift model, and brand for assistance."
  },
  {
    question: "Do you offer forklift rental services?",
    answer: "Yes, we provide forklift rental services. Contact us with your requirements including capacity, power type (electric/diesel), rental duration, location, and application to get assistance with equipment rental."
  },
  {
    question: "What should I do if my forklift breaks down?",
    answer: "Contact us immediately via WhatsApp or phone for urgent breakdown support. Provide details about the equipment (brand, model, fuel type), location, nature of the problem, and any error codes or symptoms. We prioritize breakdown enquiries and respond promptly."
  },
  {
    question: "Which areas do you serve?",
    answer: "Our registered office is in Kinnigoli (Mangaluru region) and our branch office is in Bengaluru (Chikkabanavara). We primarily serve Karnataka and South India, but accept enquiries from across India and can arrange service in various locations."
  },
  {
    question: "Do you service multiple forklift brands?",
    answer: "Yes, we have technical experience with multiple leading forklift manufacturers. Our team is trained to work on various brands and we maintain knowledge of different systems and components across the industry."
  },
  {
    question: "How do I request a service?",
    answer: "You can reach us through three main channels: WhatsApp (+91 81051 42089), email (neelenterprises.741@gmail.com), or by filling out our detailed online service request form. Choose the method that works best for your enquiry type."
  },
  {
    question: "Can I send photos of my equipment or problem?",
    answer: "Yes, sending photos helps us understand your requirement better. You can share equipment photos, nameplate details, or images of the specific problem via WhatsApp or email. This enables faster diagnosis and more accurate responses."
  },
  {
    question: "Do you provide Annual Maintenance Contracts (AMC)?",
    answer: "Yes, we offer scheduled maintenance contracts for fleets and individual equipment. AMC programs include regular inspections, preventive maintenance, and priority support to keep your operations running smoothly throughout the year."
  }
];
---

<BaseLayout lang="en">
  <Header />

  <main class="min-h-screen bg-white dark:bg-gray-950">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-50 to-orange-50 dark:from-gray-900 dark:to-gray-800"></div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6">
            Frequently Asked <span class="text-orange-600">Questions</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8">
            Everything You Need to Know About Our Services
          </p>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Find answers to common questions about forklift repair, maintenance, spare parts, rental services, and how to work with NEEL ENTERPRISES.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-white dark:bg-gray-950">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-6">
          {faqs.map((faq, index) => (
            <details 
              class="group bg-gray-50 dark:bg-gray-900 rounded-2xl overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300"
              key={index}
            >
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <h3 class="text-lg md:text-xl font-semibold text-gray-900 dark:text-white pr-8">
                  {faq.question}
                </h3>
                <svg 
                  class="w-6 h-6 text-orange-600 flex-shrink-0 transform group-open:rotate-180 transition-transform duration-300" 
                  fill="none" 
                  stroke="currentColor" 
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-300 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>

        <!-- Still Have Questions CTA -->
        <div class="mt-16 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
            Still Have Questions?
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
            Our team is ready to help with any queries about forklift services, maintenance, or technical support.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="https://wa.me/918105142089?text=Hello%20NEEL%20ENTERPRISES%2C%20I%20have%20a%20question%20about%20your%20forklift%20services."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-8 py-4 bg-green-600 text-white font-semibold rounded-xl hover:bg-green-700 transition-colors duration-300 shadow-lg"
            >
              <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Ask on WhatsApp
            </a>
            <a 
              href="mailto:neelenterprises.741@gmail.com"
              class="inline-flex items-center justify-center px-8 py-4 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors duration-300 shadow-lg"
            >
              <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Email Your Question
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Links Section -->
    <section class="py-20 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Explore Our Services
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400">
            Learn more about what we offer
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a href="/services/" class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-md hover:shadow-lg transition-shadow text-center">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">All Services</h3>
            <p class="text-gray-600 dark:text-gray-400">Complete list of our offerings</p>
          </a>
          <a href="/about/" class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-md hover:shadow-lg transition-shadow text-center">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">About Us</h3>
            <p class="text-gray-600 dark:text-gray-400">Learn about our experience</p>
          </a>
          <a href="/contact/" class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-md hover:shadow-lg transition-shadow text-center">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Contact</h3>
            <p class="text-gray-600 dark:text-gray-400">Get in touch with us</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  
  <script>
    document.title = pageTitle;
    
    const metaDescription = document.querySelector('meta[name="description"]');
    if (metaDescription) {
      metaDescription.setAttribute('content', pageDescription);
    } else {
      const newMeta = document.createElement('meta');
      newMeta.name = 'description';
      newMeta.content = pageDescription;
      document.head.appendChild(newMeta);
    }
    
    const linkCanonical = document.querySelector('link[rel="canonical"]');
    if (linkCanonical) {
      linkCanonical.setAttribute('href', canonicalURL);
    } else {
      const newLink = document.createElement('link');
      newLink.rel = 'canonical';
      newLink.href = canonicalURL;
      document.head.appendChild(newLink);
    }
  </script>
  
  <!-- FAQ Schema.org JSON-LD -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": {faqs.map((faq, index) => ({
          "@type": "Question",
          "position": index + 1,
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))}
      }
    }
  </script>
</BaseLayout>
