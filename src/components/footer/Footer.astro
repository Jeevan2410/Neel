---
// Footer Component for NEEL ENTERPRISES
// Comprehensive footer with navigation, contact info, and legal links

import { siteConfig } from '../../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer bg-neutral-900 dark:bg-neutral-950 text-neutral-300">
  
  <!-- Main Footer Content -->
  <div class="container mx-auto px-4 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 md:gap-12">
      
      <!-- Company Info Column -->
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-3 mb-4">
          <img src="/logo.png" alt="NEEL ENTERPRISES" class="h-10 w-auto brightness-0 invert" />
          <div>
            <h3 class="font-display font-bold text-lg text-white">NEEL ENTERPRISES</h3>
            <p class="text-sm text-neutral-400">Material Handling Engineering</p>
          </div>
        </div>
        <p class="text-sm text-neutral-400 mb-6 max-w-md">
          Professional forklift repair, maintenance, spare parts, and rental services with 18+ years of experience in material handling equipment across India.
        </p>
        
        <!-- Contact Info -->
        <div class="space-y-3 text-sm">
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-primary-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:{siteConfig.company.email}" class="hover:text-primary-400 transition-colors">
              {siteConfig.company.email}
            </a>
          </div>
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-primary-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:{siteConfig.company.phone.replace(/\D/g, '')}" class="hover:text-primary-400 transition-colors">
              {siteConfig.company.phone}
            </a>
          </div>
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-primary-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <a 
              href="https://wa.me/{siteConfig.company.whatsapp.replace(/\D/g, '')}" 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-primary-400 transition-colors"
            >
              WhatsApp Available
            </a>
          </div>
        </div>
      </div>
      
      <!-- Quick Links Column -->
      <div>
        <h4 class="font-display font-semibold text-white mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-primary-400 transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-primary-400 transition-colors">About Us</a></li>
          <li><a href="/services" class="hover:text-primary-400 transition-colors">Services</a></li>
          <li><a href="/industries" class="hover:text-primary-400 transition-colors">Industries</a></li>
          <li><a href="/locations" class="hover:text-primary-400 transition-colors">Locations</a></li>
          <li><a href="/faq" class="hover:text-primary-400 transition-colors">FAQ</a></li>
          <li><a href="/contact" class="hover:text-primary-400 transition-colors">Contact</a></li>
        </ul>
      </div>
      
      <!-- Services Column -->
      <div>
        <h4 class="font-display font-semibold text-white mb-4">Services</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/services/electric-forklift-repair" class="hover:text-primary-400 transition-colors">Electric Forklift Repair</a></li>
          <li><a href="/services/diesel-forklift-repair" class="hover:text-primary-400 transition-colors">Diesel Forklift Repair</a></li>
          <li><a href="/services/preventive-maintenance" class="hover:text-primary-400 transition-colors">Preventive Maintenance</a></li>
          <li><a href="/services/battery-service" class="hover:text-primary-400 transition-colors">Battery Service</a></li>
          <li><a href="/services/spare-parts" class="hover:text-primary-400 transition-colors">Spare Parts</a></li>
          <li><a href="/services/forklift-rental" class="hover:text-primary-400 transition-colors">Forklift Rental</a></li>
          <li><a href="/request-service" class="hover:text-primary-400 transition-colors">Request Service</a></li>
        </ul>
      </div>
      
      <!-- Locations Column -->
      <div>
        <h4 class="font-display font-semibold text-white mb-4">Our Locations</h4>
        <div class="space-y-4 text-sm">
          <div>
            <h5 class="font-medium text-white mb-1">{siteConfig.locations.registered.name}</h5>
            <p class="text-neutral-400 text-xs mb-2">{siteConfig.locations.registered.address}</p>
            <a 
              href={siteConfig.locations.registered.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-400 hover:text-primary-300 text-xs inline-flex items-center"
            >
              View on Maps
              <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
          <div>
            <h5 class="font-medium text-white mb-1">{siteConfig.locations.branch.name}</h5>
            <p class="text-neutral-400 text-xs mb-2">{siteConfig.locations.branch.address}</p>
            <a 
              href={siteConfig.locations.branch.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-400 hover:text-primary-300 text-xs inline-flex items-center"
            >
              View on Maps
              <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Bottom Bar -->
  <div class="border-t border-neutral-800">
    <div class="container mx-auto px-4 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        
        <!-- Copyright -->
        <p class="text-sm text-neutral-400">
          &copy; {currentYear} NEEL ENTERPRISES. All rights reserved.
        </p>
        
        <!-- Legal Links -->
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <a href="/privacy-policy" class="text-neutral-400 hover:text-primary-400 transition-colors">
            Privacy Policy
          </a>
          <span class="text-neutral-600">•</span>
          <a href="/terms-and-conditions" class="text-neutral-400 hover:text-primary-400 transition-colors">
            Terms & Conditions
          </a>
        </div>
        
        <!-- Language Switcher (Mobile) -->
        <div class="flex items-center space-x-2">
          {siteConfig.languages.map((lang, index) => (
            <>
              {index > 0 && <span class="text-neutral-600">•</span>}
              <button
                class="text-sm text-neutral-400 hover:text-primary-400 transition-colors"
                aria-label={`Switch to ${lang.name}`}
              >
                {lang.nativeName}
              </button>
            </>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer a {
    transition: color 0.2s ease;
  }
</style>
